<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keeps the Cloudflare Tunnel for capture.andrewcarrier.dev running. Config: ~/.cloudflared/config.yml -->
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.carrierpigeonai.stream-capture-tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/cloudflared</string>
    <string>tunnel</string>
    <string>run</string>
    <string>stream-capture</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/andrew/Library/Logs/stream-capture-tunnel.log</string>
  <key>StandardErrorPath</key><string>/Users/andrew/Library/Logs/stream-capture-tunnel.log</string>
</dict>
</plist>
